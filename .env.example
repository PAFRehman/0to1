# This site works without service keys: create a wallet, deploy a classroom wall,
# and mint notes / compact images / signatures / private file proofs.
# Public Base Sepolia RPC is the default. For a class, an RPC provider is optional.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional default wall. Deploy through the website, then paste the contract address.
# This is public, not a secret. Every viewer then opens the same classroom wall.
NEXT_PUBLIC_MINT_CONTRACT=

# Optional larger-media upload. These are SERVER ONLY. Never prefix with NEXT_PUBLIC_.
PINATA_JWT=
UPLOAD_AUTH_SECRET=

# Optional QR/mobile wallet connections. Browser wallets do not require this setting.
# Public Reown project ID; allow your Vercel / custom domains in its dashboard.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
